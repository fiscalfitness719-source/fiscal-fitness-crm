# Neon Postgres connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# Initial admin credentials used by db:seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
